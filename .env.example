# Dispatcharr → Music Assistant Bridge v5.6.9 example environment

SOURCE_MODE=xc
XC_BASE_URL=http://dispatcharr:9191
XC_USERNAME=
XC_PASSWORD=
XC_OUTPUT=ts
XC_VERIFY_SSL=true
XC_CATEGORY_IDS=
NAME_FILTER=
GROUP_FILTER=SiriusXM

PUBLIC_BASE_URL=http://bridge:8088
DEFAULT_FORMAT=mp3

# Persistent catalog
CATALOG_REFRESH_SECONDS=86400
CATALOG_RETRY_SECONDS=3600

# Audio
AAC_MODE=copy
AAC_BITRATE=128k
MP3_BITRATE=192k
SAMPLE_RATE=48000
CHANNELS=2
SOURCE_RW_TIMEOUT_SECONDS=60
UPSTREAM_STARTUP_TIMEOUT_SECONDS=30

# Shared v5 hub behavior
UPSTREAM_MAX_CONNECTIONS=2
STREAM_LINGER_SECONDS=30
STREAM_SUBSCRIBER_QUEUE_CHUNKS=16
STREAM_RESTART_DELAY=1
STREAM_READ_CHUNK_BYTES=16384
STREAM_COALESCE_BYTES=8192
STREAM_COALESCE_MAX_SECONDS=0.50
STREAM_OUTPUT_PACING=true
STREAM_OUTPUT_PACING_SLACK_SECONDS=0.25
STREAM_JITTER_BUFFER_ENABLED=true
STREAM_JITTER_BUFFER_ADAPTIVE=true
STREAM_JITTER_BUFFER_MIN_SECONDS=2.0
STREAM_JITTER_BUFFER_SECONDS=4.0
STREAM_JITTER_BUFFER_MAX_SECONDS=16.0
STREAM_JITTER_BUFFER_INCREASE_SECONDS=2.0
STREAM_JITTER_BUFFER_DECREASE_SECONDS=1.0
STREAM_JITTER_BUFFER_STABLE_SECONDS=600
STREAM_RING_BUFFER_SECONDS=0.5

# Cold-start protection
STARTUP_SILENCE_ENABLED=true
STARTUP_SILENCE_MAX_SECONDS=60
STARTUP_REAL_AUDIO_RETRIES=3
STARTUP_REAL_AUDIO_RETRY_DELAY=2
POST_START_GAP_FILL_ENABLED=false
POST_START_GAP_FILL_AFTER_SECONDS=0.75

# Metadata
METADATA_ENABLED=true
METADATA_PROVIDER=ticker
METADATA_FALLBACK=xmplaylist
ICY_METADATA_ENABLED=true
ICY_METAINT=16384

# Ticker / SiriusXM bulk metadata
TICKER_NOWPLAYING_URL=https://stellartunerlog.com/nowplaying.json
TICKER_CHANNEL_URL=https://stellartunerlog.com/channels.json
TICKER_ACTIVE_POLL_SECONDS=15
TICKER_IDLE_POLL_SECONDS=0
TICKER_CHANNEL_REFRESH_SECONDS=86400

# xmplaylist fallback
XMPLAYLIST_POLL_SECONDS=120

# Music Assistant
MUSIC_ASSISTANT_URL=http://music-assistant:8095
MUSIC_ASSISTANT_TOKEN=
IMPORT_FORMAT=mp3
IMPORT_LOGOS=true
MA_AUTO_SYNC=true
MA_SYNC_ON_START=true
MA_SYNC_AFTER_CATALOG_REFRESH=true
MA_REMOVE_MISSING=false
MA_SYNC_RETRY_SECONDS=3600
MA_SYNC_TIMEOUT=90
MA_ADD_RETRIES=3
MA_ADD_RETRY_DELAY=3
MA_SYNC_CONCURRENCY=1
MA_IMPORT_RELEASE_GRACE_SECONDS=11

# Diagnostics
API_CHECK_TIMEOUT=10

# Logging
LOG_LEVEL=INFO
FFMPEG_LOG_LEVEL=warning
